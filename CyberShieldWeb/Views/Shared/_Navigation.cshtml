<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Cyber<span class="brand-shield">Shield</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Acas&#259;</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Despre")">Despre Noi</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Servicii
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="servicesDropdown">
                        <li><a class="dropdown-item" href="@Url.Action("Consultanta", "Servicii")">Consultanta</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("TestareaPenetrarii", "Servicii")">Testarea penetrarii</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("InginerieSociala", "Servicii")">Inginerie sociala</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("ConformitateGDPR", "Servicii")">Conformitate cu GDPR</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Index", "Servicii")">Toate serviciile</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Blog")">Blog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Contact")">Contact</a>
                </li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="@Url.Action("Index", "Admin")">
                            <i class="fas fa-cog"></i> Admin
                        </a>
                    </li>
                }
                
                @{
                    bool isSpecialist = false;
                    if (User.Identity.IsAuthenticated)
                    {
                        var db = new CyberShield.Domain.Data.CyberShieldContext();
                        var user = db.Users.FirstOrDefault(u => u.Username == User.Identity.Name);
                        isSpecialist = user != null && user.IsSpecialist;
                    }
                }
                
                @if (isSpecialist)
                {
                    <li class="nav-item">
                        <a class="nav-link text-info" href="@Url.Action("Dashboard", "Specialist")">
                            <i class="fas fa-user-md"></i> Specialist
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle"></i> @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Dashboard", "Home")">Dashboard</a></li>
                            @if (isSpecialist)
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Dashboard", "Specialist")">Dashboard Specialist</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="@Url.Action("Logout", "Auth")">Logout</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Login", "Auth")">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Register", "Auth")">Register</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
