@model CyberShield.Domain.Model.Blog.BlogPost

@{
    ViewBag.Title = "Delete Blog Post";
}

<div class="container mt-4">
    <h1>Delete Blog Post</h1>
    <hr />

    <div class="mb-3">
        <a href="@Url.Action("BlogPosts", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Blog Posts
        </a>
    </div>

    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this blog post?
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">Blog Post Details</h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Title</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        <dt class="col-sm-3">Author</dt>
                        <dd class="col-sm-9">@Model.Author</dd>

                        <dt class="col-sm-3">Date</dt>
                        <dd class="col-sm-9">@Model.PostedDate.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">@Model.Category</dd>

                        <dt class="col-sm-3">Summary</dt>
                        <dd class="col-sm-9">@Model.Summary</dd>
                    </dl>
                </div>
            </div>

            @using (Html.BeginForm("DeleteBlogPost", "Admin", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete Blog Post
                    </button>
                    <a href="@Url.Action("BlogPosts", "Admin")" class="btn btn-secondary">Cancel</a>
                </div>
            }
        </div>
    </div>
</div> 