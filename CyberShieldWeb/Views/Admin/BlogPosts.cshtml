@model IEnumerable<CyberShield.Domain.Model.Blog.BlogPost>

@{
    ViewBag.Title = "Manage Blog Posts";
}

<div class="container mt-4">
    <h1>Manage Blog Posts</h1>
    <hr />

    <div class="mb-3">
        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a href="@Url.Action("CreateBlogPost", "Admin")" class="btn btn-success float-end">
            <i class="fas fa-plus"></i> Create New Blog Post
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">All Blog Posts</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Comments</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td>@post.Id</td>
                            <td>@post.Title</td>
                            <td>@post.Author</td>
                            <td>@post.Category</td>
                            <td>@post.PostedDate.ToShortDateString()</td>
                            <td>@post.Comments.Count</td>
                            <td>
                                <div class="btn-group">
                                    <a href="@Url.Action("Post", "Blog", new { id = post.Id })" class="btn btn-info btn-sm" target="_blank">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="@Url.Action("EditBlogPost", "Admin", new { id = post.Id })" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="@Url.Action("DeleteBlogPost", "Admin", new { id = post.Id })" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 