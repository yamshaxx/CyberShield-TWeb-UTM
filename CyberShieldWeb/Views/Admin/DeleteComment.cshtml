@model CyberShield.Domain.Model.Blog.Comment

@{
    ViewBag.Title = "Delete Comment";
}

<div class="container mt-4">
    <h1>Delete Comment</h1>
    <hr />

    <div class="mb-3">
        <a href="@Url.Action("Comments", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Comments
        </a>
    </div>

    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this comment?
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">Comment Details</h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Blog Post</dt>
                        <dd class="col-sm-9">
                            <a href="@Url.Action("Post", "Blog", new { id = Model.BlogPostId })" target="_blank">
                                @(Model.BlogPost != null ? Model.BlogPost.Title : "Unknown Post")
                            </a>
                        </dd>

                        <dt class="col-sm-3">User</dt>
                        <dd class="col-sm-9">@(Model.User != null ? Model.User.Username : "Unknown User")</dd>

                        <dt class="col-sm-3">Date</dt>
                        <dd class="col-sm-9">@Model.PostedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-3">Content</dt>
                        <dd class="col-sm-9">@Model.Content</dd>
                    </dl>
                </div>
            </div>

            @using (Html.BeginForm("DeleteComment", "Admin", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete Comment
                    </button>
                    <a href="@Url.Action("Comments", "Admin")" class="btn btn-secondary">Cancel</a>
                </div>
            }
        </div>
    </div>
</div> 