@model IEnumerable<CyberShield.Domain.Model.Blog.Comment>

@{
    ViewBag.Title = "Manage Comments";
}

<div class="container mt-4">
    <h1>Manage Comments</h1>
    <hr />

    <div class="mb-3">
        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">All Comments</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Blog Post</th>
                        <th>User</th>
                        <th>Date</th>
                        <th>Content</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comment in Model)
                    {
                        <tr>
                            <td>@comment.Id</td>
                            <td>
                                <a href="@Url.Action("Post", "Blog", new { id = comment.BlogPostId })" target="_blank">
                                    @(comment.BlogPost != null ? comment.BlogPost.Title : "Unknown Post")
                                </a>
                            </td>
                            <td>@(comment.User != null ? comment.User.Username : "Unknown User")</td>
                            <td>@comment.PostedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (comment.Content.Length > 100)
                                {
                                    @comment.Content.Substring(0, 100)<text>...</text>
                                }
                                else
                                {
                                    @comment.Content
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a href="@Url.Action("Post", "Blog", new { id = comment.BlogPostId })" class="btn btn-info btn-sm" target="_blank">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="@Url.Action("DeleteComment", "Admin", new { id = comment.Id })" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 