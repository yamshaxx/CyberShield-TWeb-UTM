@model CyberShieldWeb.Models.Admin.EditBlogPostViewModel

@{
    ViewBag.Title = "Edit Blog Post";
}

<div class="container mt-4">
    <h1>Edit Blog Post</h1>
    <hr />

    <div class="mb-3">
        <a href="@Url.Action("BlogPosts", "Admin")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Blog Posts
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Edit Blog Post</h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("EditBlogPost", "Admin", FormMethod.Post, new { @class = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Id)

                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.Title, new { @class = "form-label" })
                            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(model => model.Author, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Author, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Author, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(model => model.Category, new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Category, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.Summary, new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Summary, new { @class = "form-control", rows = 3 })
                            @Html.ValidationMessageFor(model => model.Summary, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.Content, new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Content, new { @class = "form-control", rows = 15, id = "blogContent" })
                            @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            @Html.LabelFor(model => model.ImageUrl, new { @class = "form-label" })
                            @Html.EditorFor(model => model.ImageUrl, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Preview Image</h6>
                            </div>
                            <div class="card-body text-center">
                                <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid" alt="Preview" onerror="this.src='/Content/img/no-image.jpg'; this.onerror='';" />
                            </div>
                        </div>

                        <div class="card mt-4">
                            <div class="card-header">
                                <h6 class="mb-0">Tips for Writing Blog Posts</h6>
                            </div>
                            <div class="card-body">
                                <ul class="small">
                                    <li>Use HTML for formatting the content</li>
                                    <li>Create headers with &lt;h2&gt; and &lt;h3&gt; tags</li>
                                    <li>Use &lt;p&gt; tags for paragraphs</li>
                                    <li>Create lists with &lt;ul&gt; and &lt;li&gt;</li>
                                    <li>Include relevant images with &lt;img&gt; tags</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <script>
        $(document).ready(function () {
            CKEDITOR.replace('blogContent');

            $('#ImageUrl').on('input', function() {
                $('#imagePreview').attr('src', $(this).val());
            });
        });
    </script>
} 