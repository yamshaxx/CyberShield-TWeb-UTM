@model CyberShieldWeb.Models.UserDashboardViewModel
@using System.Globalization

@{
    ViewBag.Title = "Dashboard - CyberShield";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h2>Dashboard Utilizator</h2>
                </div>
                <div class="card-body">
                    <h3>Bine ai venit, @Model.Username!</h3>
                    <p class="lead">Acesta este panoul tău personal de control.</p>
                    <hr />
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h4>Informații Cont</h4>
                                </div>
                                <div class="card-body">
                                    <p><strong>Username:</strong> @Model.Username</p>
                                    <p><strong>Email:</strong> @Model.Email</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header">
                                    <h4>Securitate</h4>
                                </div>
                                <div class="card-body">
                                    <p>Sesiunea ta este securizată.</p>
                                    <p>Parola ta este criptată în baza noastră de date.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Comentariile tale -->
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h4 class="mb-0">Comentariile tale (@Model.Comments.Count)</h4>
                        </div>
                        <div class="card-body">
                            @if (Model.Comments.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Articol</th>
                                                <th>Comentariu</th>
                                                <th>Data publicării</th>
                                                <th>Acțiuni</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var comment in Model.Comments)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="@Url.Action("Post", "Blog", new { id = comment.BlogPostId })">
                                                            @comment.BlogPostTitle
                                                        </a>
                                                    </td>
                                                    <td>
                                                        @if (comment.Content.Length > 50)
                                                        {
                                                            @(comment.Content.Substring(0, 50) + "...")
                                                        }
                                                        else
                                                        {
                                                            @comment.Content
                                                        }
                                                    </td>
                                                    <td>@comment.PostedAt.ToString("d MMMM yyyy HH:mm", CultureInfo.GetCultureInfo("ro-RO"))</td>
                                                    <td>
                                                        <a href="@Url.Action("Post", "Blog", new { id = comment.BlogPostId })" class="btn btn-sm btn-primary">
                                                            <i class="fas fa-eye"></i> Vezi
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p class="mb-0">Nu ai publicat încă niciun comentariu. Vizitează <a href="@Url.Action("Index", "Blog")">blogul nostru</a> pentru a lăsa comentarii!</p>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Programările tale -->
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0">Programările tale (@Model.Appointments.Count)</h4>
                        </div>
                        <div class="card-body">
                            @if (Model.Appointments.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Serviciu</th>
                                                <th>Data programată</th>
                                                <th>Status</th>
                                                <th>Data solicitării</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in Model.Appointments)
                                            {
                                                <tr>
                                                    <td>@appointment.ServiceType</td>
                                                    <td>@appointment.PreferredDate.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo("ro-RO"))</td>
                                                    <td>
                                                        @{
                                                            string statusClass = "badge bg-secondary";
                                                            string statusText = "Necunoscut";
                                                            
                                                            switch (appointment.Status)
                                                            {
                                                                case "Pending":
                                                                    statusClass = "badge bg-warning text-dark";
                                                                    statusText = "În așteptare";
                                                                    break;
                                                                case "Confirmed":
                                                                    statusClass = "badge bg-success";
                                                                    statusText = "Confirmată";
                                                                    break;
                                                                case "Completed":
                                                                    statusClass = "badge bg-info";
                                                                    statusText = "Finalizată";
                                                                    break;
                                                                case "Cancelled":
                                                                    statusClass = "badge bg-danger";
                                                                    statusText = "Anulată";
                                                                    break;
                                                            }
                                                        }
                                                        <span class="@statusClass">@statusText</span>
                                                    </td>
                                                    <td>@appointment.CreatedAt.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo("ro-RO"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p class="mb-0">Nu ai nicio programare. <a href="@Url.Action("Programeaza", "Servicii")">Programează o consultanță</a> cu experții noștri!</p>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Mesajele tale -->
                    <div class="card mb-4 mt-4">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">Mesajele tale trimise (@Model.SentMessages.Count)</h4>
                        </div>
                        <div class="card-body">
                            @if (Model.SentMessages.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Subiect</th>
                                                <th>Mesaj</th>
                                                <th>Data trimiterii</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var message in Model.SentMessages)
                                            {
                                                <tr>
                                                    <td>@message.Subject</td>
                                                    <td>
                                                        @if (message.Message.Length > 50)
                                                        {
                                                            <span title="@message.Message">@message.Message.Substring(0, 50)...</span>
                                                        }
                                                        else
                                                        {
                                                            @message.Message
                                                        }
                                                    </td>
                                                    <td>@message.SentDate.ToString("d MMMM yyyy HH:mm", CultureInfo.GetCultureInfo("ro-RO"))</td>
                                                    <td>
                                                        @if (message.IsRead)
                                                        {
                                                            <span class="badge bg-success">Citit</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">Necitit</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <p class="mb-0">Nu ai trimis niciun mesaj. Folosește <a href="@Url.Action("Contact", "Home")">formularul de contact</a> pentru a trimite un mesaj!</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Logout", "Auth")" class="btn btn-danger">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div> 