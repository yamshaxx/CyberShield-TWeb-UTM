@{
    ViewBag.Title = "Conformitate cu GDPR";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h2 mb-0">Conformitate cu Regulamentul General privind Protecția Datelor (GDPR)</h1>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h2 class="h4">Navigarea complexității GDPR</h2>
                        <p class="lead">Servicii complete pentru conformitatea cu GDPR adaptate nevoilor organizației dumneavoastră.</p>
                        <p>Echipa CyberShield oferă asistență specializată pentru a asigura că practicile dumneavoastră de procesare a datelor personale respectă pe deplin cerințele GDPR. Abordarea noastră metodică vă ajută să implementați controale adecvate, să documentați procesele și să dezvoltați o cultură organizațională orientată spre protecția datelor.</p>
                    </div>
                    
                    <div class="mb-4">
                        <h2 class="h4">Serviciile noastre GDPR</h2>
                        <div class="list-group mb-4">
                            <div class="list-group-item">
                                <h5 class="mb-1">Audit de conformitate GDPR</h5>
                                <p class="mb-0">Evaluare completă a operațiunilor de procesare a datelor, identificarea lacunelor de conformitate și recomandări practice pentru remedierea acestora.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Dezvoltarea documentației GDPR</h5>
                                <p class="mb-0">Asistență în elaborarea politicilor de confidențialitate, procedurilor interne, registrelor de activități de prelucrare și altor documente esențiale pentru conformitate.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Evaluarea impactului asupra protecției datelor (DPIA)</h5>
                                <p class="mb-0">Realizarea evaluărilor de impact pentru operațiunile de procesare cu risc ridicat, conform cerințelor Articolului 35 din GDPR.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Ofițer de Protecție a Datelor (DPO) extern</h5>
                                <p class="mb-0">Servicii DPO furnizate de specialiști certificați, oferind expertiza necesară fără costurile asociate unui angajat cu normă întreagă.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Instruire în domeniul protecției datelor</h5>
                                <p class="mb-0">Sesiuni de formare adaptate diferitelor niveluri de personal, de la conștientizare generală până la instruire specializată pentru echipele IT și juridice.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Managementul incidentelor de securitate</h5>
                                <p class="mb-0">Dezvoltarea procedurilor de detectare, investigare și raportare a încălcărilor de securitate a datelor conform cerințelor GDPR.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h3 class="h5 mb-0">De ce este esențială conformitatea GDPR</h3>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="fas fa-gavel text-danger me-2"></i> Evitarea sancțiunilor financiare semnificative (până la 20 milioane EUR sau 4% din cifra de afaceri globală)</li>
                                        <li class="mb-2"><i class="fas fa-user-shield text-danger me-2"></i> Protejarea drepturilor fundamentale ale persoanelor vizate</li>
                                        <li class="mb-2"><i class="fas fa-handshake text-danger me-2"></i> Construirea încrederii clienților și partenerilor</li>
                                        <li class="mb-2"><i class="fas fa-shield-alt text-danger me-2"></i> Îmbunătățirea securității generale a datelor</li>
                                        <li><i class="fas fa-chart-line text-danger me-2"></i> Avantaj competitiv pe piață</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h3 class="h5 mb-0">Beneficiile abordării noastre</h3>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Expertiză juridică și tehnică combinată</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Soluții practice, nu doar teoretice</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Abordare personalizată bazată pe profilul de risc specific</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Implementare eficientă cu impact minim asupra operațiunilor</li>
                                        <li><i class="fas fa-check-circle text-success me-2"></i> Suport continuu și actualizări regulate</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-center mt-4">
                        <h3 class="h4 mb-4">Pregătiți să vă asigurați conformitatea cu GDPR?</h3>
                        <a href="@Url.Action("Programeaza", "Servicii", new { serviceType = "ConformitateGDPR" })" class="btn btn-primary btn-lg">Solicitați o evaluare inițială</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 