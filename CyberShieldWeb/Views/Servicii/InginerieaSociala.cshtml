@{
    ViewBag.Title = "Testare de Inginerie Socială";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h2 mb-0">Testare de Inginerie Socială</h1>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h2 class="h4">Importanța factorului uman în securitatea cibernetică</h2>
                        <p class="lead">Chiar și cele mai avansate sisteme de securitate pot fi compromise prin manipularea utilizatorilor legitimi.</p>
                        <p>Serviciile noastre de testare de inginerie socială evaluează rezistența organizației dumneavoastră împotriva atacurilor care vizează exploatarea comportamentului uman. Simulăm tactici reale utilizate de atacatori pentru a identifica vulnerabilitățile și a îmbunătăți conștientizarea personalului.</p>
                    </div>
                    
                    <div class="mb-4">
                        <h2 class="h4">Metode de testare</h2>
                        <div class="list-group">
                            <div class="list-group-item">
                                <h5 class="mb-1">Phishing țintit</h5>
                                <p class="mb-0">Campanii de phishing personalizate care testează capacitatea angajaților de a recunoaște și raporta e-mailuri frauduloase. Utilizăm abordări sofisticate similare cu cele folosite în atacuri reale.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Pretexting telefonic</h5>
                                <p class="mb-0">Apeluri telefonice în care evaluatorii noștri adoptă identități false pentru a obține informații confidențiale sau acces la sisteme, testând procedurile de verificare și conștientizarea personalului.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Accesul fizic neautorizat</h5>
                                <p class="mb-0">Încercări etice de a obține acces fizic în locații securizate, utilizând diverse tehnici de manipulare precum pretextarea, tailgating, sau impersonarea furnizorilor.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Baiting și drop testing</h5>
                                <p class="mb-0">Plasarea strategică a dispozitivelor de stocare infectate (USB) pentru a evalua probabilitatea utilizării lor de către angajați, identificând potențiale căi de infectare a rețelei.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Manipulare prin rețele sociale</h5>
                                <p class="mb-0">Evaluarea informațiilor expuse pe rețelele sociale și testarea susceptibilității angajaților la manipulare prin aceste canale, inclusiv prin profile false.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h2 class="h4">Ce obțineți</h2>
                        <ul class="list-group">
                            <li class="list-group-item d-flex">
                                <i class="fas fa-clipboard-check text-success me-3 mt-1"></i>
                                <span>Raport detaliat al vulnerabilităților identificate</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-clipboard-check text-success me-3 mt-1"></i>
                                <span>Analiza comportamentului angajaților în fața atacurilor simulate</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-clipboard-check text-success me-3 mt-1"></i>
                                <span>Recomandări specifice pentru îmbunătățirea conștientizării și reducerea riscurilor</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-clipboard-check text-success me-3 mt-1"></i>
                                <span>Plan de instruire personalizat pentru echipele vulnerabile</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-clipboard-check text-success me-3 mt-1"></i>
                                <span>Strategii de consolidare a culturii de securitate în organizație</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="alert alert-info">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="fas fa-info-circle fa-2x"></i>
                            </div>
                            <div>
                                <h5>Abordare etică</h5>
                                <p class="mb-0">Toate testele sunt efectuate într-un cadru etic și legal, cu acordul prealabil al managementului organizației. Confidențialitatea și protecția datelor sunt prioritare pe parcursul întregului proces.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-center mt-5">
                        <h3 class="h4 mb-4">Evaluați rezistența organizației împotriva manipulării</h3>
                        <a href="#" class="btn btn-primary btn-lg">Programați o testare</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 