@{
    ViewBag.Title = "Testarea Penetrării - CyberShield";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h2 mb-0">Teste de Penetrare</h1>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h2 class="h4">Ce oferim</h2>
                        <p class="lead">Identificăm vulnerabilitățile sistemelor dumneavoastră înainte ca atacatorii să le exploateze, cu rapoarte detaliate și recomandări.</p>
                        <p>Serviciile noastre de testare a penetrării sunt concepute pentru a evalua securitatea infrastructurii, aplicațiilor și rețelelor dumneavoastră. Echipa noastră de specialiști utilizează metodologii și instrumente avansate pentru a identifica vulnerabilitățile și a furniza recomandări practice pentru remedierea acestora.</p>
                    </div>

                    <div class="mb-4">
                        <h2 class="h4">Tipuri de evaluări disponibile</h2>
                        <div class="list-group mb-4">
                            <div class="list-group-item">
                                <h5 class="mb-1"><i class="fas fa-shield-alt text-primary me-2"></i> Evaluare Gestionată a Vulnerabilităților</h5>
                                <p class="mb-0">Scanări automatizate și manuale pentru identificarea vulnerabilităților din infrastructura IT, cu prioritizarea acestora în funcție de risc și impact.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1"><i class="fas fa-globe text-primary me-2"></i> Pentest Aplicație Web</h5>
                                <p class="mb-0">Testarea aprofundată a aplicațiilor web pentru a identifica vulnerabilități precum injecții SQL, XSS, CSRF și alte riscuri din Top 10 OWASP.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1"><i class="fas fa-users text-primary me-2"></i> Echipă Roșie</h5>
                                <p class="mb-0">Simulări avansate de atacuri care combină tehnici multiple pentru a testa eficacitatea generală a securității organizației dumneavoastră.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1"><i class="fas fa-network-wired text-primary me-2"></i> Pentest Rețea</h5>
                                <p class="mb-0">Evaluarea securității infrastructurii de rețea, inclusiv dispozitive de rețea, servere și configurații pentru a identifica vulnerabilitățile.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1"><i class="fas fa-code text-primary me-2"></i> API Pentest</h5>
                                <p class="mb-0">Evaluarea securității interfețelor de programare a aplicațiilor pentru a identifica vulnerabilități specifice care ar putea compromite datele și funcționalitățile.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h2 class="h4">Procesul nostru de evaluare</h2>
                        <div class="card p-4 bg-light">
                            <ol class="list-group list-group-numbered">
                                <li class="list-group-item">Definirea scopului și obiectivelor testării</li>
                                <li class="list-group-item">Colectarea informațiilor și descoperirea activă</li>
                                <li class="list-group-item">Identificarea vulnerabilităților și analiza acestora</li>
                                <li class="list-group-item">Exploatarea vulnerabilităților (cu acordul clientului)</li>
                                <li class="list-group-item">Raportare detaliată cu recomandări pentru remediere</li>
                                <li class="list-group-item">Asistență pentru remedierea vulnerabilităților</li>
                            </ol>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h2 class="h4">Beneficii</h2>
                        <ul class="list-group">
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Identificarea vulnerabilităților înainte ca acestea să fie exploatate de atacatori</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Evaluare profesională realizată de experți certificați în securitate</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Rapoarte detaliate cu pași de remediere clari și prioritizați</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Reducerea riscurilor de securitate și a potențialelor pierderi financiare</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Conformitate cu standardele și reglementările din domeniu</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="text-center mt-5">
                        <h3 class="h4 mb-4">Pregătiți să testați securitatea sistemelor dumneavoastră?</h3>
                        <a href="@Url.Action("Programeaza", "Servicii", new { serviceType = "TestareaPenetrarii" })" class="btn btn-primary btn-lg">Programează o evaluare</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item h5 .fas {
            width: 20px;
            text-align: center;
        }
    </style>
} 
