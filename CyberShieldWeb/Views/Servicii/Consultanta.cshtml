@{
    ViewBag.Title = "Consultanță în Securitate Cibernetică";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h2 mb-0">Consultanță în Securitate Cibernetică</h1>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h2 class="h4">Ce oferim</h2>
                        <p class="lead">Servicii personalizate de consultanță pentru a vă ajuta să dezvoltați și să implementați o strategie robustă de securitate cibernetică.</p>
                        <p>CyberShield vă oferă expertiză de specialitate pentru a vă proteja organizația împotriva amenințărilor cibernetice în continuă evoluție. Echipa noastră de consultanți cu experiență înțelege provocările unice cu care se confruntă afacerea dumneavoastră și vă poate ajuta să implementați cele mai bune practici de securitate.</p>
                    </div>
                    
                    <div class="mb-4">
                        <h2 class="h4">Servicii de consultanță</h2>
                        <div class="list-group">
                            <div class="list-group-item">
                                <h5 class="mb-1">Evaluarea riscurilor de securitate</h5>
                                <p class="mb-0">Identificăm și evaluăm vulnerabilitățile și riscurile de securitate specifice organizației dumneavoastră, oferind recomandări prioritizate pentru atenuarea acestora.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Dezvoltarea strategiei de securitate</h5>
                                <p class="mb-0">Creăm strategii de securitate personalizate, aliniate cu obiectivele de afaceri, resursele disponibile și toleranța la risc a organizației dumneavoastră.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Conformitate și standarde</h5>
                                <p class="mb-0">Vă ghidăm prin procesul de conformare cu reglementările relevante (GDPR, ISO 27001, PCI DSS) și vă ajutăm să implementați controale adecvate.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Răspuns la incidente</h5>
                                <p class="mb-0">Dezvoltăm planuri de răspuns la incidente și oferim asistență în situații de criză pentru a minimiza impactul breșelor de securitate.</p>
                            </div>
                            <div class="list-group-item">
                                <h5 class="mb-1">Securitate cloud</h5>
                                <p class="mb-0">Evaluăm și consolidăm securitatea infrastructurii cloud pentru a proteja datele și aplicațiile găzduite în medii AWS, Azure, sau Google Cloud.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <h2 class="h4">Beneficii</h2>
                        <ul class="list-group">
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Reducerea riscurilor de securitate și a vulnerabilităților</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Conformitate cu reglementările și standardele din domeniu</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Optimizarea investițiilor în securitatea IT</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Dezvoltarea unei culturi organizaționale orientate spre securitate</span>
                            </li>
                            <li class="list-group-item d-flex">
                                <i class="fas fa-check-circle text-success me-3 mt-1"></i>
                                <span>Protejarea reputației și a încrederii clienților</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="text-center mt-5">
                        <h3 class="h4 mb-4">Pregătiți să vă îmbunătățiți postura de securitate?</h3>
                        <a href="#" class="btn btn-primary btn-lg">Solicitați o consultare gratuită</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 